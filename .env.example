
# SEO / Analytics
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_SOCIAL_LINKS=
NEXT_PUBLIC_BUSINESS_GEO=
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# --- Required in production (2026-11 audit) ---
# Must be the real public origin; placeholder values are ignored by lib/site.ts.
#   e.g. NEXT_PUBLIC_SITE_URL=https://<production-domain>  (set on line 3 above)
# NextAuth signing secret (generate: openssl rand -base64 32). Never reuse a value from git history.
AUTH_SECRET=
NEXTAUTH_URL=
# Salt for hashed visitor IPs in analytics (falls back to AUTH_SECRET).
ANALYTICS_IP_SALT=
# Optional: admin account created by `prisma db seed` (password min 12 chars).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Domain forwarding: adonerp.com -> adonerp.com.bd (lib/geo/domain-forward.ts) ---
# Shared HMAC secret (min 32 chars; generate: openssl rand -base64 32). Unset = forwarded
# visitors get normal country detection. Must match the forwarding edge if one is used
# (scripts/domain-forward/cloudflare-worker.js).
DOMAIN_FORWARD_SECRET=
# Hosts forwarded to the target when they reach this app (www. is implied).
DOMAIN_FORWARD_SOURCE_HOSTS=adonerp.com
DOMAIN_FORWARD_TARGET_ORIGIN=https://adonerp.com.bd
# Token lifetime in seconds (default 120, max 600).
DOMAIN_FORWARD_TTL_SECONDS=
# Geo header your edge overwrites (only needed off Vercel, e.g. cf-ipcountry).
GEO_COUNTRY_HEADER=

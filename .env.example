
# SEO / Analytics
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_SOCIAL_LINKS=
NEXT_PUBLIC_BUSINESS_GEO=
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# --- Required in production (2026-11 audit) ---
# Must be the real public origin; placeholder values are ignored by lib/site.ts.
#   e.g. NEXT_PUBLIC_SITE_URL=https://<production-domain>  (set on line 3 above)
# Required in development AND production: persistent NextAuth signing secret.
# Generate: openssl rand -base64 32. Never reuse a value from git history.
# NEXTAUTH_SECRET is also supported and takes precedence when nonblank.
AUTH_SECRET=
NEXTAUTH_URL=
# Salt for hashed visitor IPs in analytics (falls back to AUTH_SECRET).
ANALYTICS_IP_SALT=
# Optional: admin account created by `prisma db seed` (password min 12 chars).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Domain forwarding: adonerp.com -> adonerp.com.bd (lib/geo/domain-forward.ts) ---
# Shared HMAC secret (min 32 chars; generate: openssl rand -base64 32). Unset = forwarded
# visitors get normal country detection. Must match the forwarding edge if one is used
# (scripts/domain-forward/cloudflare-worker.js).
DOMAIN_FORWARD_SECRET=
# Hosts forwarded to the target when they reach this app (www. is implied).
DOMAIN_FORWARD_SOURCE_HOSTS=adonerp.com
DOMAIN_FORWARD_TARGET_ORIGIN=https://adonerp.com.bd
# Token lifetime in seconds (default 120, max 600).
DOMAIN_FORWARD_TTL_SECONDS=
# Geo header your edge overwrites (only needed off Vercel, e.g. cf-ipcountry).
GEO_COUNTRY_HEADER=

# Demo submission notifications. When enabled, npm run dev / npm start also run
# the worker automatically. Recipients (WhatsApp numbers, emails) and the
# WhatsApp QR link are managed in Admin → Notifications.
DEMO_NOTIFICATIONS_ENABLED=false
# Set to "off" to NOT auto-start the worker (run npm run notifications:worker
# yourself, e.g. on another machine or for all but one of several instances).
NOTIFICATIONS_WORKER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=adonerp4@gmail.com
SMTP_PASSWORD="your Gmail app password"
SMTP_FROM_NAME="Adon ERP"
# Persistent directory for the WhatsApp session and login QR; never commit it.
WHATSAPP_AUTH_PATH=.wwebjs_auth
# Optional existing Chrome/Chromium executable; otherwise Puppeteer's browser is used.
WHATSAPP_EXECUTABLE_PATH=
